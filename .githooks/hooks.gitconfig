# Git config-based hooks (Git 2.54+). Enable once per clone:
#   git config set --local include.path ../.githooks/hooks.gitconfig
# Git appends the hook's own arguments (for pre-push: remote name and URL); "&& :" swallows them.
[hook "check"]
	command = vp check && :
	event = pre-commit
[hook "verify"]
	command = vp run verify && :
	event = pre-push
[hook "e2e"]
	command = vp exec playwright test --workers=2 && :
	event = pre-push
